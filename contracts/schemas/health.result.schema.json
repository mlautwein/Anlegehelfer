  "additionalProperties": false,
  "properties": {
    "app_version": {
      "title": "App Version",
      "type": "string"
    },
    "data_dir": {
      "title": "Data Dir",
      "type": "string"
    },
    "db_path": {
      "title": "Db Path",
      "type": "string"
    },
    "db_schema_version": {
      "title": "Db Schema Version",
      "type": "integer"
    },
