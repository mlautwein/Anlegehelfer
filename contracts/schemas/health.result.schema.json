          "default": 0,
          "title": "Holder Pid",
          "type": "integer"
        },
        "holder_workstation": {
          "default": "",
          "title": "Holder Workstation",
          "type": "string"
        },
        "locked": {
          "default": false,
          "title": "Locked",
          "type": "boolean"
        },
        "owned": {
          "default": false,
          "title": "Owned",
          "type": "boolean"
        },
        "stale": {
          "default": false,
          "title": "Stale",
          "type": "boolean"
        }
